#include <stdio.h>
#include <stdlib.h> 
struct node 
{ 
 int info; 
 struct node *link; 
}; 
typedef struct node *NODE; 
NODE first = NULL, cur = NULL;
NODE createnode();
void insertfront();
void deletefront(); 
void display(); 
int main() 
{ 
 int ch; 
 while (1) 
 { 
 printf("\n1.Insert Front\n 2.Delete Front \n 3.Exit \n Enter your choice: "); 
 scanf("%d", &ch); 
 switch (ch) 
 { 
 case 1: 
 insertfront(); 
 break; 
 case 2: 
 deletefront(); 
 break; 
 case 3:exit(0); 
 } 
 } 
 return 0; 
}NODE createnode() 
{ 
 NODE temp; 
 temp = malloc(sizeof(struct node));
 printf("Enter info:");
 scanf("%d", &temp->info);
 temp->link = NULL;
 return temp; 
} 
void insertfront() 
{ 
 NODE temp = createnode();
 if (first == NULL) 
 { 
 first = temp;  
 } 
 else
 {  
 temp->link = first; 
 first = temp; 
 } 
 display();
} 
void deletefront() 
{ 
 if(first==NULL) 
 { 
 printf("\n List is Empty\n"); 
 return; 
 } 
 first=first->link; 
 display(); 
}void display() 
{ 
 cur = first;  
 printf("\n List "); 
 while (cur != NULL) 
 { 
 printf("%d->", cur->info); 
 cur = cur->link;  
 } 
}
